DATABASE_URL=postgresql+asyncpg://devhub:devhub@localhost:5432/devhub

# docker-compose isteğe bağlı override'lar (boş bırakılırsa devhub/devhub/devhub kullanılır).
# Gerçek bir ortamda mutlaka güçlü değerler verin.
# POSTGRES_USER=devhub
# POSTGRES_PASSWORD=devhub
# POSTGRES_DB=devhub

# JWT — production'da `openssl rand -hex 32` ile üretilen güçlü bir secret kullanın.
SECRET_KEY=change-me-in-production-please-use-a-strong-random-key
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=60
